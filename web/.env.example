# Copy to web/.env and fill in. web/.env is gitignored — never commit real values.

# The Python API. Only the server-side BFF routes read this, never the browser.
API_URL=http://localhost:8000

# Simpro API — used server-side only by /api/simpro/*
# e.g. https://<your-company>.simprosuite.com/api/v1.0
SIMPRO_BASE_URL=
SIMPRO_API_TOKEN=
