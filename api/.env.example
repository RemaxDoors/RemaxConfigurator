# Copy to api/.env and fill in. api/.env is gitignored.

# M1 SQL Server (same values as the Streamlit app's src/.env)
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Windows/local: "ODBC Driver 17 for SQL Server"
# Docker image:  "ODBC Driver 18 for SQL Server"  (see api/Dockerfile)
DB_DRIVER=ODBC Driver 17 for SQL Server

# Origins allowed to call this API directly (the Next dev server)
ALLOWED_ORIGINS=http://localhost:3000
