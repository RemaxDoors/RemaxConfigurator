# Copy to api/.env and fill in. api/.env is gitignored.

# M1 SQL Server (same values as the Streamlit app's src/.env)
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Windows/local: "ODBC Driver 17 for SQL Server"
# Docker image:  "ODBC Driver 18 for SQL Server"  (see api/Dockerfile)
DB_DRIVER=ODBC Driver 17 for SQL Server

# Origins allowed to call this API directly (the Next dev server)
ALLOWED_ORIGINS=http://localhost:3000

# The app-owned configuration database (uCfg* tables)
CONFIG_DB_NAME=RP_config

# The config DB defaults to the M1 server and credentials above. Set these
# only when it lives somewhere else — e.g. Azure SQL alongside an
# on-premises M1. Nothing joins across the two databases.
# CONFIG_DB_SERVER=
# CONFIG_DB_USER=
# CONFIG_DB_PASSWORD=
# CONFIG_DB_DRIVER=
